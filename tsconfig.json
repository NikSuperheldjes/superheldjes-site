{
  "extends": "astro/tsconfigs/strict",
  "include": [
    "**/*.ts", 
    "**/*.tsx", 
    "src/**/*.astro", 
    "keystatic.config.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@assets/*": ["./src/assets/*"]
    }
  }
}